{
  "uid": "junos-user-ports",
  "title": "Junos user ports (NETCONF)",
  "description": "Access-port state polled from access1 over NETCONF by the read-only 'telemetry' account, published as XML and parsed by the Infinity datasource.",
  "tags": [
    "junos",
    "netconf",
    "containerlab"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Ports up",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "junos-netconf-xml"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "junos-netconf-xml"
          },
          "type": "xml",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "http://clab-junos-netconf-grafana-poller:8080/users.xml",
          "url_options": {
            "method": "GET",
            "data": ""
          },
          "root_selector": "poll.user",
          "columns": [
            {
              "selector": "port",
              "text": "Port",
              "type": "string"
            },
            {
              "selector": "up",
              "text": "Up",
              "type": "number"
            }
          ],
          "filters": [],
          "global_query_id": ""
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "/^Up$/",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "green",
                "value": 4
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Users online",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "junos-netconf-xml"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "junos-netconf-xml"
          },
          "type": "xml",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "http://clab-junos-netconf-grafana-poller:8080/users.xml",
          "url_options": {
            "method": "GET",
            "data": ""
          },
          "root_selector": "poll.user",
          "columns": [
            {
              "selector": "port",
              "text": "Port",
