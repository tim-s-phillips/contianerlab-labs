              "type": "number"
            },
            {
              "selector": "online",
              "text": "Online",
              "type": "number"
            },
            {
              "selector": "mac",
              "text": "MAC",
              "type": "string"
            },
            {
              "selector": "ip",
              "text": "IP",
              "type": "string"
            },
            {
              "selector": "vlan",
              "text": "VLAN",
              "type": "string"
            },
            {
              "selector": "speed",
              "text": "Speed",
              "type": "string"
            },
            {
              "selector": "lastflap",
              "text": "Last flap",
              "type": "string"
            },
            {
              "selector": "flapsecs",
              "text": "Flap age (s)",
              "type": "number"
            },
            {
              "selector": "rxpkts",
              "text": "Rx pkts",
              "type": "number"
            },
            {
              "selector": "txpkts",
              "text": "Tx pkts",
              "type": "number"
            },
            {
              "selector": "rxerrors",
              "text": "Rx errors",
              "type": "number"
            },
            {
              "selector": "txerrors",
              "text": "Tx errors",
              "type": "number"
            }
          ],
          "filters": [],
          "global_query_id": ""
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Port",
            "desc": false
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Admin"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "up": {
                        "color": "green",
                        "index": 0,
                        "text": "up"
                      },
                      "down": {
                        "color": "red",
                        "index": 1,
                        "text": "down"
                      },
                      "unknown": {
                        "color": "text",
                        "index": 2,
                        "text": "unknown"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Oper"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "up": {
                        "color": "green",
                        "index": 0,
                        "text": "up"
                      },
                      "down": {
                        "color": "red",
                        "index": 1,
                        "text": "down"
                      },
                      "unknown": {
                        "color": "text",
                        "index": 2,
                        "text": "unknown"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Up"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "color": "red",
                        "index": 0,
                        "text": "DOWN"
                      },
                      "1": {
                        "color": "green",
                        "index": 1,
                        "text": "UP"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Online"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
