              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "green",
                "value": 4
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Poll status",
      "description": "Written by the poller each cycle. status=error means the NETCONF poll failed - the reason is in the error column.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "junos-netconf-xml"
      },
      "gridPos": {
        "h": 4,
        "w": 16,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "junos-netconf-xml"
          },
          "type": "xml",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "http://clab-junos-netconf-grafana-poller:8080/users.xml",
          "url_options": {
            "method": "GET",
            "data": ""
          },
          "root_selector": "poll",
          "columns": [
            {
              "selector": "device",
              "text": "Device",
              "type": "string"
            },
            {
              "selector": "timestamp",
              "text": "Polled at",
              "type": "string"
            },
            {
              "selector": "status",
              "text": "Status",
              "type": "string"
            },
            {
              "selector": "error",
              "text": "Error",
              "type": "string"
            },
            {
              "selector": "ports",
              "text": "Ports",
              "type": "number"
            },
            {
              "selector": "portsup",
              "text": "Ports up",
              "type": "number"
            }
          ],
          "filters": [],
          "global_query_id": ""
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ok": {
                        "color": "green",
                        "index": 0
                      },
                      "error": {
                        "color": "red",
                        "index": 1
                      },
                      "starting": {
                        "color": "orange",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Connected users",
      "description": "One row per access port: interface state from get-interface-information, MAC from get-ethernet-switching-table-information, IP joined via get-arp-table-information.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "junos-netconf-xml"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "junos-netconf-xml"
          },
          "type": "xml",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "http://clab-junos-netconf-grafana-poller:8080/users.xml",
          "url_options": {
            "method": "GET",
            "data": ""
          },
          "root_selector": "poll.user",
          "columns": [
            {
              "selector": "port",
              "text": "Port",
              "type": "string"
            },
            {
              "selector": "name",
              "text": "User",
              "type": "string"
            },
            {
              "selector": "admin",
              "text": "Admin",
              "type": "string"
            },
            {
              "selector": "oper",
